# Default local development URI
MONGODB_URI=mongodb://localhost:27017/node_api

# Required for authenticated flows. Use a long random value outside development.
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
DEFAULT_CURRENCY=USD

# Optional live exchange-rate provider settings. The app also supports manual/stored rates.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# If running the API in a container on the same docker network as the mongo service, use:
# MONGODB_URI=mongodb://mongo:27017/node_api
