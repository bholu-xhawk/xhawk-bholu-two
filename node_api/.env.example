# Default local development URI
MONGODB_URI=mongodb://localhost:27017/node_api

# If running the API in a container on the same docker network as the mongo service, use:
# MONGODB_URI=mongodb://mongo:27017/node_api

# Origin for the first xhawk-bholu API that serves /api/users/directory
XHAWK_BHOLU_API_BASE_URL=http://localhost:3001
